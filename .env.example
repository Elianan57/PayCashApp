# Server Configuration
PORT=3050
NODE_ENV=production
BASE_URL=https://yourdomain.com

# Polapine API Keys (Replace with production keys for live payments)
POLAPINE_API_KEY=your_production_public_key
POLAPINE_API_SECRET=your_production_secret_key

# Optional: Webhook Secret (if using signature verification)
# WEBHOOK_SECRET=your_webhook_secret

# Email Notifications (Resend SMTP)
RESEND_API_KEY=re_your_api_key
ADMIN_EMAIL=your_admin@email.com
